# Copy this file to .env and fill in your values

# ── Razorpay (payments) ────────────────────────────────────────────────────
# Get your key from https://dashboard.razorpay.com/app/keys
# Use rzp_test_... for testing, rzp_live_... for production
REACT_APP_RAZORPAY_KEY=rzp_test_YOUR_KEY_HERE

# ── Supabase (database + auth) ────────────────────────────────────────────
# Get these from https://supabase.com → your project → Settings → API
# Then run: npm install @supabase/supabase-js
# Then run the SQL from supabase-schema.sql in Supabase's SQL editor
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
