# Copy this file to .env and fill in your values

# ── Razorpay (payments) ────────────────────────────────────────────────────
# Public checkout key ID only. Never put the Razorpay key secret in a REACT_APP_ variable.
# Use rzp_test_... for testing, rzp_live_... for production.
REACT_APP_RAZORPAY_KEY=rzp_test_YOUR_KEY_HERE

# ── Supabase (database + auth) ────────────────────────────────────────────
# Get these from https://supabase.com → your project → Settings → API
# Apply supabase-schema.sql in Supabase's SQL editor, then deploy the Edge Functions.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Set these only as Supabase Edge Function secrets. Never expose them to React.
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
